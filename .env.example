# Airtable Personal Access Token with read-only access to the SAFETY base.
# Create it at https://airtable.com/create/tokens (scope: data.records:read,
# base: SAFETY only). Never commit the real value — set it in Vercel's
# Environment Variables settings for Production and Preview.
AIRTABLE_TOKEN=

# Optional overrides. Defaults are already hardcoded as fallback constants
# in src/lib/airtable.ts, so these only need to be set if the base/table
# ever change.
AIRTABLE_BASE_ID=appDSjIPinS4TgaHF
AIRTABLE_TABLE_ID=tbldKTwfyG5MIZZ1N

# Postgres connection string for the accounts (login) database. Provisioned
# via Vercel's Neon integration — auto-injected in Vercel, only needed here
# for local development (e.g. via `vercel env pull`).
DATABASE_URL=

# Random secret used to sign session cookies (JWT). Generate with:
# openssl rand -base64 32
SESSION_SECRET=

# Temporary shared secret for the one-time /api/setup endpoint used to
# initialize the accounts table and seed initial collaborator accounts.
# Remove this env var (and delete src/app/api/setup) once initial accounts
# are seeded.
SETUP_TOKEN=
